# Copy to .env (git-ignored) and fill in. NEVER commit a real key.
# 32 random bytes, standard base64. Generate with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LOCATION_ENC_KEY=
# Identifier recorded in location_enc.key_id (no key material).
LOCATION_ENC_KEY_ID=local-dev-1
KAFKA_BOOTSTRAP=localhost:9092
# Service database for old-jobs/maintenance-sync (local Postgres in docker-compose). Generate a password with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
SERVICE_DB_PASSWORD=
SERVICE_DB_HOST=localhost
SERVICE_DB_PORT=5432
SERVICE_DB_NAME=service_db
SERVICE_DB_USER=service
